---
// A sentence the tower finishes. Its last word is left for the model to say:
// while the tower makes its forward pass on the sentence, the word's place
// holds a cursor. When the pass begins the words before it are split into
// tokens, quickly, each tinted with its id over it for a moment. Then the
// candidates for the next token are listed above the cursor with their
// probabilities, which shift as the pass climbs the layers, until the sphere
// says the word and here it is. Where there is no room above the sentence
// (portrait) there are no ids and no list: the word just arrives with its
// probability beside it for a moment.
//
// Without the tower (no script, reduced motion, no WebGL) the sentence is
// simply there.
//
// `prompt` is the sentence up to the word, as tokens with their ids, each
// with the space before it. Each candidate is its token, its probability
// going into the layers and its probability coming out; the first one is
// the word.
interface Props {
  prompt: [token: string, id: number][];
  candidates: [token: string, before: number, after: number][];
}

const { prompt, candidates } = Astro.props;
---

<span class="sentence" data-next data-candidates={JSON.stringify(candidates)}
  >{
    prompt.map(([token, id], i) => (
      <span class="tok" style={`--i: ${i}`}>{token.startsWith(" ") ? " " : ""}<span class="word">{token.trim()}<span class="id" aria-hidden="true">{id}</span></span></span>
    ))
  }{" "}<span class="next"
    ><span class="token">{candidates[0][0]}</span
    ><span class="dist" aria-hidden="true"
      ><span class="label">next token</span
      ><span class="rows" style={`--count: ${candidates.length}`}
        >{
          candidates.map(([token]) => (
            <span class="row">
              <span>{token}</span>
              <span class="bar">
                <i />
              </span>
              <span class="p" />
            </span>
          ))
        }</span
      ></span
    ><span class="chance" aria-hidden="true"></span></span
  ></span
>

<style>
  /* The prompt's tokens: tinted one after another, in two tints by turns,
     for as long as the pass is on its way. */
  .tok {
    border-radius: 3px;
    transition: background 0.5s var(--ease);
  }
  .predicting .tok {
    background: color-mix(in srgb, var(--blue) 13%, transparent);
    transition-duration: 0.15s;
    transition-delay: calc(var(--i) * 90ms);
  }
  .predicting .tok:nth-child(even) {
    background: color-mix(in srgb, var(--yellow) 34%, transparent);
  }
  .word {
    position: relative;
  }
  .id {
    position: absolute;
    left: 0;
    bottom: calc(100% - 0.12em);
    font: 500 11px / 1 var(--font-mono);
    letter-spacing: 0;
    color: var(--ink-soft);
    opacity: 0;
    /* Over the candidates' paper, which comes up as the ids go. */
    z-index: 1;
  }
  .predicting .id {
    animation: id 1.1s var(--ease) calc(var(--i) * 90ms);
  }
  @keyframes id {
    from {
      transform: translateY(3px);
    }
    12%,
    70% {
      opacity: 1;
      transform: none;
    }
  }

  .next {
    position: relative;
    white-space: nowrap;
  }
  .waiting .token {
    opacity: 0;
  }
  .said .token {
    animation: say 1.8s var(--ease);
  }
  @keyframes say {
    from {
      color: var(--blue);
    }
  }

  /* The cursor, where the word will go. */
  .next::before {
    content: "";
    position: absolute;
    left: 0.03em;
    bottom: -0.04em;
    width: 0.07em;
    height: 0.82em;
    background: var(--blue);
    opacity: 0;
  }
  .waiting .next::before {
    opacity: 1;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* The candidates, set like the tower's weights, on a patch of paper that
     feathers out, so the sky's numbers do not run through them. Each row
     keeps its place in the markup and moves to its rank. The list ends
     where the word does, so it never reaches past the sentence into the
     tower. */
  .dist {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    background: var(--paper);
    box-shadow: 0 0 12px 14px var(--paper);
    font: 500 13px / 1 var(--font-mono);
    letter-spacing: 0;
    color: var(--ink-soft);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  /* They come up once the prompt is in tokens. */
  .predicting .dist {
    opacity: 1;
    transition-delay: 0.7s;
  }
  /* Once the word is said the list stays a moment, then goes. */
  .said .dist {
    transition-delay: 1.6s;
  }
  .label {
    display: block;
    margin-bottom: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .rows {
    display: block;
    position: relative;
    width: calc(10ch + 120px);
    height: calc(var(--count) * 20px);
  }
  .row {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    grid-template-columns: 6ch 96px 4ch;
    column-gap: 12px;
    align-items: center;
    height: 20px;
    transform: translateY(calc(var(--rank, 0) * 20px));
    transition:
      transform 0.28s var(--ease),
      color 0.28s var(--ease),
      opacity 0.4s var(--ease);
  }
  .row.top {
    color: var(--ink);
  }
  .bar {
    height: 6px;
    background: var(--line);
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
    transition:
      transform 0.28s var(--ease),
      background 0.3s var(--ease);
  }
  .said .row:not(.top) {
    opacity: 0.4;
  }
  .said .row.top i {
    background: var(--yellow);
  }

  .chance {
    position: absolute;
    left: calc(100% + 0.5em);
    bottom: 0.2em;
    font: 500 12px / 1 var(--font-mono);
    letter-spacing: 0;
    color: var(--blue);
    opacity: 0;
  }
  @keyframes chance {
    15%,
    70% {
      opacity: 1;
    }
  }

  @container hero (max-aspect-ratio: 11/10) {
    .id,
    .dist {
      display: none;
    }
    .said .chance {
      animation: chance 2.6s var(--ease);
    }
  }
</style>
