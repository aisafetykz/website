---
// The homepage hero: the eagle and the hand. Page content goes in the slot and
// sits over the left side (wide screens) or the bottom (phones), where the
// scene keeps clear and a gradient keeps the text readable.
//
// The still images are rendered from the same scene with `bun run poster`;
// the live version replaces them when WebGPU is available.
---

<section class="hero" data-berkutchi>
  <picture>
    <source media="(max-aspect-ratio: 11/10)" srcset="/berkutchi-mobile.webp" />
    <img
      class="poster"
      src="/berkutchi.webp"
      width="1600"
      height="900"
      fetchpriority="high"
      alt="Halftone illustration of a golden eagle made of gold dots, soaring beneath a 36-ray sun over the steppe and distant mountains."
    />
  </picture>
  <canvas aria-hidden="true"></canvas>
  <div class="scrim" aria-hidden="true"></div>

  <div class="container content">
    <div class="copy">
      <slot />
    </div>
  </div>
</section>

<script>
  // Load the GPU code only for browsers that can run it. Everyone else keeps
  // the still image.
  const canAnimate = "gpu" in navigator && !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-berkutchi]").forEach((el) => {
    if (!canAnimate) return;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        import("../berkutchi/client").then(({ mount }) => mount(el)).catch(() => {});
      },
      { rootMargin: "400px" },
    );
    io.observe(el);
  });
</script>

<style>
  .hero {
    --shade: 255, 247, 244; /* #fff7f4, the paper the art is printed on */
    position: relative;
    height: 100svh;
    min-height: 640px;
    max-height: 980px;
    overflow: hidden;
    background: #fff7f4;
    color: var(--ink);
    isolation: isolate;
    /* The scene picks its layout from the hero's shape, so the text does too. */
    container: hero / size;
  }
  .poster,
  canvas,
  .scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .poster {
    object-fit: cover;
    object-position: 100% 50%;
    transition: opacity 0.8s ease;
  }
  canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
    cursor: pointer;
    touch-action: manipulation;
  }
  [data-state="live"] canvas {
    opacity: 1;
  }
  [data-state="live"] .poster {
    opacity: 0;
  }

  /* Darkens the side the text sits on; the art keeps its own side clear. */
  .scrim {
    pointer-events: none;
    background:
      /* the header sits on this */
      linear-gradient(180deg, rgba(var(--shade), 0.85) 0, rgba(var(--shade), 0) 140px),
      linear-gradient(90deg, rgba(var(--shade), 0.94) 0%, rgba(var(--shade), 0.86) 32%, rgba(var(--shade), 0.35) 47%, rgba(var(--shade), 0) 57%),
      /* melts the bottom edge into the page */
      linear-gradient(0deg, rgb(var(--shade)) 0%, rgba(var(--shade), 0.85) 9%, rgba(var(--shade), 0) 30%);
  }

  /* The overlay lets clicks through to the canvas, except on the text block. */
  .content {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
  }
  .copy {
    /* Never wider than the clear side of the frame. */
    max-width: min(32rem, 44cqw);
    text-shadow: 0 0 24px rgba(var(--shade), 0.9);
  }
  /* The text block itself takes the pointer, so its text can be selected and copied. */
  .copy {
    pointer-events: auto;
  }
  .copy :global(.lede) {
    color: var(--ink-soft);
  }

  @media (max-aspect-ratio: 11/10) {
    .hero {
      height: 100svh;
      min-height: 820px;
    }
  }

  /* Portrait: the art takes the top, the text the bottom. */
  @container hero (max-aspect-ratio: 11/10) {
    .poster {
      object-position: 50% 30%;
    }
    .scrim {
      background:
        linear-gradient(180deg, rgba(var(--shade), 0.85) 0, rgba(var(--shade), 0) 110px),
        linear-gradient(
          0deg,
          rgb(var(--shade)) 0%,
          rgba(var(--shade), 0.9) 40%,
          rgba(var(--shade), 0.45) 57%,
          rgba(var(--shade), 0) 68%
        );
    }
    .content {
      align-items: flex-end;
      bottom: 48px;
    }
    .copy {
      max-width: 36rem;
    }
    .copy :global(.display) {
      font-size: clamp(1.95rem, 8.6vw, 3.2rem);
      margin: 14px 0 16px;
    }
    .copy :global(.lede) {
      font-size: 1.05rem;
    }
    .copy :global(.actions) {
      margin-top: 22px;
      gap: 8px;
    }
    .copy :global(.btn) {
      padding: 0.55em 1em;
      font-size: 0.95rem;
    }
  }
</style>
