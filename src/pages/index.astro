---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import NextToken from "../components/NextToken.astro";
---

<Base>
  <Hero>
    <h1 class="display">AI Safety Kazakhstan</h1>
    <a class="btn join" slot="corner" href="https://t.me/aisafetykz" target="_blank" rel="noopener">Join</a>
    <p slot="statement">
      <NextToken
        prompt={[
          ["Making", 23874],
          [" sure", 1654],
          [" AI", 9552],
          [" goes", 2925],
        ]}
        candidates={[
          ["well", 0.12, 0.93],
          ["wrong", 0.27, 0.02],
          ["on", 0.24, 0.01],
          ["away", 0.2, 0.01],
          ["right", 0.17, 0.03],
        ]}
      />
    </p>
    <div slot="aside">
      <p class="lede">A community in Kazakhstan working toward reducing risks.</p>
      <div class="actions">
        <a class="btn" href="https://t.me/aisafetykz" target="_blank" rel="noopener">Join the community <span class="arrow">→</span></a>
      </div>
    </div>
  </Hero>
</Base>

<style>
  .display {
    font-size: var(--text-display);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0;
    /* Trims the line's top space, so the capitals can line up with the header. */
    text-box: trim-both cap alphabetic;
  }
  .join {
    min-height: 40px;
    padding: 0.4em 1.1em;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
