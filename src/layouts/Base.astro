---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

const title = "AI Safety Kazakhstan";
const description = "Making sure AI goes well. A community in Kazakhstan working toward reducing risks.";
const imageAlt = "AI Safety Kazakhstan in large serif letters made of numbers, beside the Baiterek tower set in the same numbers.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: title,
  alternateName: "AI Safety KZ",
  url: Astro.site?.href,
  description,
  email: "hello@aisafetykz.org",
  areaServed: { "@type": "Country", name: "Kazakhstan" },
  sameAs: ["https://t.me/aisafetykz"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/twitter.png", Astro.site).href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Brygada+1918:wght@400..700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
